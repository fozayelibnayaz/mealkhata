{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mealkhata",
  "main": "server/app.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "APP_ENV": "production",
    "ALLOW_SANDBOX": "false",
    "APP_ORIGIN": "https://mealkhata.ayazwork2026.workers.dev",
    "GOOGLE_CLIENT_ID": "982453680372-3ootgt3la58if8vtct88s8e7grljd4u3.apps.googleusercontent.com"
  },
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mealkhata-pilot",
      "database_id": "33e73aae-04c3-4cda-8035-ffa668dd7c5e",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  }
}
