{
  "name": "mealkhata",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build && node scripts/build-sw.mjs",
    "test": "npm run test:unit && npm run test:schema && npm run test:browser",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "dev:api": "wrangler dev --local --ip 0.0.0.0 --port 8787",
    "db:migrate": "wrangler d1 migrations apply mealkhata-local --local",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test:schema": "python3 scripts/test_schema.py",
    "test:smoke": "node scripts/smoke-api.mjs",
    "test:integration": "node scripts/test-workspace-api.mjs",
    "test:a11y": "node scripts/check-accessibility.mjs",
    "deploy:pilot": "node scripts/check-deploy.mjs && npm run build && wrangler deploy --config wrangler.pilot.jsonc",
    "test:pwa": "node scripts/check-pwa.mjs",
    "deploy:live": "node scripts/check-deploy.mjs wrangler.live.jsonc && wrangler d1 migrations apply mealkhata-pilot --remote --config wrangler.live.jsonc && wrangler deploy --config wrangler.live.jsonc"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260919.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fast-check": "^4.10.1",
    "jsonc-parser": "^3.3.1",
    "node": "^22.23.2",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
